# Local development and testing only.
# Create your own copy with:  cp .env.example .env && chmod 600 .env
# On Railway this file is NOT used: set Variables with the same names instead.
# Keep comments on their own lines (python-dotenv misreads "KEY=   # comment").

# Bot token from @BotFather (/newbot). Format: 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (ask @userinfobot). Only this account is served.
OWNER_ID=

# false = PREVIEW mode: replies are only printed to the logs, nothing is sent.
# true  = replies are sent from your account automatically.
AUTO_SEND=false

# Claude subscription token: the output of `claude setup-token` (sk-ant-oat...).
# Create it once on a computer with a browser; it is valid for 1 year.
# Treat it like a password. Paste it with an editor, on ONE line (not with echo).
# Leave empty to use this machine's own `claude` login (local testing only).
# Anthropic API keys (sk-ant-api...) are rejected on purpose.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = found on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Claude model, e.g. sonnet or opus. Empty = the CLI default.
CLAUDE_MODEL=

# Thinking effort: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up.
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to stop replying after a usage limit when Claude gives no reset time.
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays quiet there for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# How many recent messages per chat are kept and shown to Claude.
HISTORY_LIMIT=30
